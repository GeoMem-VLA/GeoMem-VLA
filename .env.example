# Copy to .env, replace placeholders, then: set -a; source .env; set +a
# Activate your Python environment yourself; no machine-specific conda/proxy settings.
BASE_VLM="/path/to/Qwen3-VL-4B-Instruct"
VGGT_CKPT="/path/to/vggt/model.pt"
VGGT_REPO="/path/to/vggt-source"
LIBERO_DATA_ROOT="/path/to/LEROBOT_LIBERO_DATA"
ROBOTWIN_DATA_ROOT="/path/to/RoboTwin_lerobot"
LIBERO_HOME="/path/to/LIBERO"
CKPT="/path/to/checkpoints/steps_20000_pytorch_model.pt"

NUM_PROCESSES=1
PER_DEVICE_BATCH_SIZE=16
GROUP_SIZE=16
MEM_LENGTH=16
NUM_WORKERS=4
MAX_TRAIN_STEPS=20000
NUM_WARMUP_STEPS=100
SAVE_INTERVAL=1000
WANDB_MODE=disabled
# Optional: CUDA_VISIBLE_DEVICES=0
# Optional: GRADIENT_ACCUMULATION_STEPS=4 (LIBERO default 4, RoboTwin default 8)
